<?xml version="1.0" encoding="utf-8"?>
<!-- AI Analysis screen layout -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5FF">

    <!-- Top gradient header -->
    <LinearLayout
        android:id="@+id/headerAnalysis"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_gradient_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Title row: screen title + arrow -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtAnalysisTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/analysis_title"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <!-- You can use this as back or menu later -->
            <ImageView
                android:id="@+id/imgAnalysisArrow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@android:color/white"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtAnalysisSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/analysis_subtitle"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <!-- Scrollable content area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollAnalysis"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/headerAnalysis"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Mood status card -->
            <LinearLayout
                android:id="@+id/cardMoodStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_status_card"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/txtStatusEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="😊"
                    android:textSize="40sp"/>

                <TextView
                    android:id="@+id/txtStatusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_label"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/txtStatusValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_value_default"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/txtStatusNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_note_default"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Section: mood chart title -->
            <TextView
                android:id="@+id/txtMoodChartTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mood_chart_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="20dp"/>

            <!-- Simple chart card (line chart using MPAndroidChart) -->
            <LinearLayout
                android:id="@+id/cardMoodChart"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card"
                android:layout_marginTop="8dp"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mood_chart_subtitle"
                    android:textSize="13sp"
                    android:textColor="#777777"/>

                <!-- LineChart -->
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/lineChartMood"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                    tools:ignore="MissingClass" />
            </LinearLayout>

            <!-- Section: AI recommendations -->
            <TextView
                android:id="@+id/txtAiRecsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_recs_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="20dp"/>

            <!-- Card: positive pattern -->
            <LinearLayout
                android:id="@+id/cardPattern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card"
                android:padding="12dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/txtPatternTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pattern_title_default"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1B5E20"/>

                <TextView
                    android:id="@+id/txtPatternBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pattern_body_default"
                    android:textSize="13sp"
                    android:textColor="#555555"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Card: improvement suggestion -->
            <LinearLayout
                android:id="@+id/cardSuggestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card"
                android:padding="12dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/txtSuggestionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/suggestion_title_default"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#6A1B9A"/>

                <TextView
                    android:id="@+id/txtSuggestionBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/suggestion_body_default"
                    android:textSize="13sp"
                    android:textColor="#555555"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Section: statistics -->
            <TextView
                android:id="@+id/txtStatsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="20dp"/>

            <!-- Row of small stat cards -->
            <LinearLayout
                android:id="@+id/layoutStatsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <!-- Total entries -->
                <LinearLayout
                    android:id="@+id/cardTotalEntries"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_white_card"
                    android:padding="8dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_total_entries_label"
                        android:textSize="12sp"
                        android:textColor="#777777"/>

                    <TextView
                        android:id="@+id/txtTotalEntries"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_total_entries_default"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>
                </LinearLayout>

                <!-- Average mood -->
                <LinearLayout
                    android:id="@+id/cardAvgMood"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_white_card"
                    android:padding="8dp"
                    android:layout_marginStart="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_avg_mood_label"
                        android:textSize="12sp"
                        android:textColor="#777777"/>

                    <TextView
                        android:id="@+id/txtAvgMood"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_avg_mood_default"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
