<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_light"
    android:layoutDirection="locale"
    android:textDirection="locale">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/homeRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp">

        <!-- Header Gradient -->
        <View
            android:id="@+id/headerBg"
            android:layout_width="0dp"
            android:layout_height="240dp"
            android:background="@drawable/bg_header_gradient"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Notification icon -->
        <ImageView
            android:id="@+id/ivBell"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_bell"
            app:tint="@android:color/white"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- User avatar -->
        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_user_circle"
            app:tint="@android:color/white"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- User name -->
        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sample_user_name"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toTopOf="@id/ivAvatar"
            app:layout_constraintEnd_toStartOf="@id/ivAvatar"/>

        <!-- Welcome -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/home_welcome"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="18dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/ivAvatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvHowFeel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/how_feel"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvWelcome"
            app:layout_constraintStart_toStartOf="@id/tvWelcome"
            app:layout_constraintEnd_toEndOf="@id/tvWelcome"/>

        <!-- CTA Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardRecordMood"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="6dp"
            android:backgroundTint="@android:color/transparent"
            app:layout_constraintTop_toBottomOf="@id/tvHowFeel"
            app:layout_constraintStart_toStartOf="@id/tvWelcome"
            app:layout_constraintEnd_toEndOf="@id/tvWelcome">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_orange_gradient"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layoutDirection="locale">

                <TextView
                    android:id="@+id/tvRecordMood"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/record_mood_now"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow"
                    app:tint="@android:color/white"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Last Entry title -->
        <TextView
            android:id="@+id/tvLastEntryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/last_entry"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/text_dark"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@id/cardRecordMood"
            app:layout_constraintStart_toStartOf="@id/tvWelcome"
            app:layout_constraintEnd_toEndOf="@id/tvWelcome"/>

        <!-- Last Entry Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLastEntry"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/tvLastEntryTitle"
            app:layout_constraintStart_toStartOf="@id/tvWelcome"
            app:layout_constraintEnd_toEndOf="@id/tvWelcome">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layoutDirection="locale">

                <TextView
                    android:id="@+id/tvLastMoodEmoji"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="😊"
                    android:gravity="center"
                    android:textSize="20sp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:id="@+id/tvLastMoodLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sample_mood_label"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/text_dark"/>

                    <TextView
                        android:id="@+id/tvLastMoodDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2025-11-08"
                        android:textSize="12sp"
                        android:textColor="@color/text_gray"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Services title -->
        <TextView
            android:id="@+id/tvServices"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/services"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/text_dark"
            android:layout_marginTop="18dp"
            app:layout_constraintTop_toBottomOf="@id/cardLastEntry"
            app:layout_constraintStart_toStartOf="@id/tvWelcome"
            app:layout_constraintEnd_toEndOf="@id/tvWelcome"/>

        <!-- Big Services Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardServicesContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:backgroundTint="@android:color/white"
            app:layout_constraintTop_toBottomOf="@id/tvServices"
            app:layout_constraintStart_toStartOf="@id/tvWelcome"
            app:layout_constraintEnd_toEndOf="@id/tvWelcome">

            <GridLayout
                android:id="@+id/gridServices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:padding="10dp"
                android:useDefaultMargins="true"
                android:alignmentMode="alignMargins"
                android:layoutDirection="locale">

                <!-- 1) Questionnaire -->
                <LinearLayout
                    android:id="@+id/cardQuestionnaire"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_service_purple"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:clipToOutline="true">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_form" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mood_check"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

                <!-- 2) AI Analysis -->
                <LinearLayout
                    android:id="@+id/cardAI"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_service_blue"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:clipToOutline="true">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_chart"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_analysis"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

                <!-- 3) Support -->
                <LinearLayout
                    android:id="@+id/cardSupport"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_service_green"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:clipToOutline="true">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_arrow" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/support"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

                <!-- 4) Settings -->
                <LinearLayout
                    android:id="@+id/cardSettings"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_service_orange"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:clipToOutline="true">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_settings" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

            </GridLayout>

        </androidx.cardview.widget.CardView>

        <!-- Tip Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardTip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:layout_constraintTop_toBottomOf="@id/cardServicesContainer"
            app:layout_constraintStart_toStartOf="@id/tvWelcome"
            app:layout_constraintEnd_toEndOf="@id/tvWelcome"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:layoutDirection="locale">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tip_today"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark"/>

                <TextView
                    android:id="@+id/tvTipBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tip_today_body"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <!-- Bottom Navigation -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:background="@android:color/white"
            app:itemIconTint="@drawable/bottom_nav_selector"
            app:itemTextColor="@drawable/bottom_nav_selector"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
