<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_light"
    android:layoutDirection="rtl"
    android:textDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_brain"
            android:background="@drawable/bg_circle_logo"
            android:padding="18dp"
            android:layout_gravity="center"
            android:layout_marginTop="28dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/register_title"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="@color/text_dark"
            android:layout_gravity="center"
            android:layout_marginTop="14dp" />

        <!-- Full Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/full_name"
            android:textSize="12sp"
            android:textColor="@color/text_dark"
            android:layout_marginTop="22dp" />

        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="12dp"
            android:hint="@string/full_name"
            android:inputType="textPersonName"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_hint"
            android:layout_marginTop="6dp" />

        <!-- Username -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/username"
            android:textSize="12sp"
            android:textColor="@color/text_dark"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="12dp"
            android:hint="@string/username"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_hint"
            android:layout_marginTop="6dp" />

        <!-- Email -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/email"
            android:textSize="12sp"
            android:textColor="@color/text_dark"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="12dp"
            android:hint="@string/email"
            android:inputType="textEmailAddress"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_hint"
            android:layout_marginTop="6dp" />

        <!-- Gender -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gender"
            android:textSize="12sp"
            android:textColor="@color/text_dark"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/spGender"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="12dp"
            android:layout_marginTop="6dp" />

        <!-- Birth Year -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/birth_year"
            android:textSize="12sp"
            android:textColor="@color/text_dark"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etBirthYear"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="12dp"
            android:hint="@string/birth_year"
            android:inputType="number"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_hint"
            android:layout_marginTop="6dp" />

        <!-- Password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/password"
            android:textSize="12sp"
            android:textColor="@color/text_dark"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="12dp"
            android:hint="@string/password"
            android:inputType="textPassword"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_hint"
            android:layout_marginTop="6dp" />

        <!-- Confirm Password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/password_confirm"
            android:textSize="12sp"
            android:textColor="@color/text_dark"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="12dp"
            android:hint="@string/password_confirm"
            android:inputType="textPassword"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_hint"
            android:layout_marginTop="6dp" />

        <!-- Register Button -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/register_btn"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="@drawable/bg_btn_gradient"
            android:layout_marginTop="18dp" />

        <!-- Go to Login -->
        <TextView
            android:id="@+id/tvLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/have_account"
            android:textSize="14sp"
            android:textColor="@color/purple_start"
            android:layout_marginTop="12dp"
            android:layout_gravity="center" />

    </LinearLayout>
</ScrollView>
