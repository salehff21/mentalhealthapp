<?xml version="1.0" encoding="utf-8"?>
<!-- Questionnaire screen layout matching the Figma design -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5FF"
    android:layoutDirection="rtl">

    <!-- Top gradient header -->
    <LinearLayout
        android:id="@+id/header"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_gradient_header"
        android:layout_width="0dp"
        android:layout_height="140dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Title row: screen title + next arrow -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="استبيان نفسي"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="20sp"
                android:gravity="center"/>

            <ImageView
                android:id="@+id/imgNextArrow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@android:color/white"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtQuestionCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="السؤال 1 من 6"
            android:textColor="@android:color/white"
            android:layout_marginTop="12dp"
            android:textSize="13sp"/>

        <!-- Progress bar showing current question -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="6"
            android:progress="1"
            android:progressDrawable="@drawable/progress_question"/>
    </LinearLayout>

    <!-- Question text -->
    <TextView
        android:id="@+id/txtQuestion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="هل تشعر بالرضا عن حياتك الاجتماعية؟"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#222222"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Small subtitle under the question -->
    <TextView
        android:id="@+id/txtSubTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="اختر الإجابة الأقرب لحالتك"
        android:textSize="13sp"
        android:textColor="#777777"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/txtQuestion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Answer options -->
    <RadioGroup
        android:id="@+id/radioGroupOptions"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/txtSubTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RadioButton
            android:id="@+id/rbOption1"
            style="@style/QuestionOptionStyle"
            android:text="راضٍ جدًا"/>

        <RadioButton
            android:id="@+id/rbOption2"
            style="@style/QuestionOptionStyle"
            android:text="راضٍ"/>

        <RadioButton
            android:id="@+id/rbOption3"
            style="@style/QuestionOptionStyle"
            android:text="محايد"/>

        <RadioButton
            android:id="@+id/rbOption4"
            style="@style/QuestionOptionStyle"
            android:text="غير راضٍ"/>
    </RadioGroup>

    <!-- Hint under options -->
    <TextView
        android:id="@+id/txtHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="اضغط على الخيار للمتابعة"
        android:textColor="#999999"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/radioGroupOptions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Bottom navigation buttons (Previous / Next) -->
    <LinearLayout
        android:id="@+id/bottomButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnPrev"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="السؤال السابق"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_button_purple"/>

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="السؤال التالي"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_button_purple"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
