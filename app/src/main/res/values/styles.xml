<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="QuestionOptionStyle">
        <!-- Full-width card option -->
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>

        <!-- Rounded card background: gradient when checked, white when not -->
        <item name="android:background">@drawable/bg_option_selector</item>

        <!-- Replace default radio circle with our selector (checked/unchecked icon) -->
        <item name="android:button">@drawable/radio_icon_selector</item>

        <!-- Spacing and text style -->
        <item name="android:padding">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:textColor">#222222</item>
    </style>


</resources>